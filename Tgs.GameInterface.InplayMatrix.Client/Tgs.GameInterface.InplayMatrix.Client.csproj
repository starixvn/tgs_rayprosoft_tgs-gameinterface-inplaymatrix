<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net7.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>0.0.2</Version>
		<Authors>Raypro</Authors>
		<RootNamespace>Tgs.GameInterface.InplayMatrix.Client</RootNamespace>
		<PackageId>Tgs.GameInterface.InplayMatrix.Client</PackageId>
		<Title>Tgs.GameInterface.InplayMatrix.Client</Title>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-inplaymatrix</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-inplaymatrix.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Tgs GameInterface InplayMatrix Client</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.52.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.52.0" />
		<PackageReference Include="Grpc.Tools" Version="2.54.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.NuGet.BuildTools" Version="0.0.2" />
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Tgs.GameInterface.InplayMatrix.Common\Tgs.GameInterface.InplayMatrix.Common.csproj">
	    <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	</ItemGroup>

	<ItemGroup>
	  <Protobuf Include="..\Tgs.GameInterface.InplayMatrix\Protos\gameinterfaceinplaymatrix.proto" GrpcServices="Client">
	    <Link>gameinterfaceinplaymatrix.proto</Link>
	  </Protobuf>
	</ItemGroup>

</Project>
